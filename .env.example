# ── Database (matches docker-compose defaults) ────────────────────────────────
DATABASE_URL="postgresql://nycparcel:nycparcel@localhost:5432/nycparcel_dev"
POSTGRES_USER=nycparcel
POSTGRES_PASSWORD=nycparcel
POSTGRES_DB=nycparcel_dev

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# OAuth (optional for local dev — leave blank to use email/password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Mapping ───────────────────────────────────────────────────────────────────
# WARNING: NEXT_PUBLIC_* variables are embedded in the browser bundle and
# visible to anyone who loads the page. NEVER prefix server-side secrets with
# NEXT_PUBLIC_. In particular:
#   • SOCRATA_APP_TOKEN must NEVER become NEXT_PUBLIC_SOCRATA_APP_TOKEN —
#     exposing it publicly lets anyone exhaust your rate-limit quota.
#   • SendGrid, internal webhook URLs, and DB credentials must stay server-only.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── ETL ───────────────────────────────────────────────────────────────────────
# Register a free app token at data.cityofnewyork.us (ETL.md §1)
# Server-only — see WARNING above about NEXT_PUBLIC_.
SOCRATA_APP_TOKEN=
SLACK_WEBHOOK_URL=
SENDGRID_API_KEY=

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
